# Run locally with: MARKETPLACE_MODE=development python3 app.py
MARKETPLACE_MODE=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=marketplace.sqlite3
# Set this to the Supabase PostgreSQL connection string on the server to use Supabase.
# Keep the password private; never put this value in frontend code or commit it.
DATABASE_URL=
# Listing photos need a public-read Supabase Storage bucket; keep the service role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LISTING_IMAGES_BUCKET=listing-images
BACKUP_DIR=backups
DELIVERY_ENCRYPTION_KEY=
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional seed-only admin bootstrap; never use a shared/default password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Production integrations are deliberately disabled until merchant credentials and contracts exist.
PAYMENT_PROVIDER=disabled
# Production sales remain closed unless a verified live adapter and operator approval exist.
MARKETPLACE_SALES_ENABLED=false
# Comma-separated game slugs cleared for sale after publisher/legal review; default is none.
MARKETPLACE_APPROVED_GAME_SLUGS=
# Account transfers need separate written clearance per game; default is none.
MARKETPLACE_APPROVED_ACCOUNT_GAME_SLUGS=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# Set to resend for API delivery, smtp for SMTP, or disabled for local token-only mode.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=SentryLoot <onboarding@resend.dev>
PUBLIC_BASE_URL=http://localhost:8000
# OAuth provider credentials. In development, the callback follows the browser host
# (localhost or 127.0.0.1); in production it uses PUBLIC_BASE_URL. Register the exact
# redirect URI shown by the app's active host at /api/oauth/{provider}/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_API_BASE_URL=https://verification.didit.me
# Optional advisory listing review. Store the key as a server-side Vercel secret only.
# Gemini free-tier prompts may be used to improve Google's products; only redacted,
# public listing fields are sent. AI never approves/rejects listings or takes account actions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
